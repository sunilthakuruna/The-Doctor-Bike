/* Attach evidence where a business record exists; new-form files save with that record. */
/* Keep attachment controls on supporting-document records only. Services, accounts and appointments do not expose these controls. Existing file data remains untouched. */
let activeDocumentSave=null;
function draftDocumentFiles(files){if(!Array.isArray(files)||files.length>6||files.some(f=>!safeAttachment(f)||!Number.isFinite(Number(f.size))||Number(f.size)>1024*1024))throw Error('Choose up to 6 valid PDF, JPG, PNG or WebP files, no larger than 1 MB each.');return files}
function applyDraftDocuments(context){let record=find(context.key,context.id);if(!record)throw Error('Record was not created; attachments could not be saved.');let files=draftDocumentFiles(context.files);record.attachments=structuredClone(files);if(new Blob([JSON.stringify(db)]).size>4*1024*1024)throw Error('Local storage limit reached. Remove unused files or use smaller images.');return record}
const saveBeforeDocumentCoverage=save;
save=function(message){let context=activeDocumentSave;if(!context)return saveBeforeDocumentCoverage(message);try{applyDraftDocuments(context);let result=saveBeforeDocumentCoverage(message);if(result===false)db=structuredClone(context.before);return result}catch(error){db=structuredClone(context.before);toast(error.message);return false}};
function ensureRecordDocuments(key,id,form){
 if(!attachmentModules.includes(key)||!form||form.querySelector('[data-draft-documents]')||form.querySelector('.attachmentPanel'))return;
 let body=form.querySelector('.formbody');if(!body)return;
 for(let note of body.querySelectorAll('.notice'))if(note.textContent.includes('Save this new record first'))note.remove();
 if(id&&find(key,id)){body.insertAdjacentHTML('beforeend',attachmentPanel(key,id));return}
 let panel=document.createElement('section');panel.className='attachmentPanel';panel.dataset.draftDocuments='';panel.innerHTML='<h3>'+(key==='insurance'?'Insurance Policy Documents & Images':'Documents & Images')+'</h3><p>'+(key==='insurance'?'Attach an insurance policy, renewal or claim file. PDF, JPG, PNG or WebP · 1 MB per file · up to 6 files. Files are saved with this insurance record.':'Attach the supplier bill, receipt, photo or supporting document. PDF, JPG, PNG or WebP · 1 MB per file · up to 6 files. Files are saved when you save this record.')+'</p><input type="file" data-draft-document-upload multiple accept="application/pdf,image/jpeg,image/png,image/webp" aria-label="'+(key==='insurance'?'Attach insurance image or PDF':'Attach documents and images')+'"><div class="draftDocumentList"></div><p class="draftDocumentStatus" role="status"></p>';body.appendChild(panel);
 let files=[],busy=false,input=panel.querySelector('input'),list=panel.querySelector('.draftDocumentList'),status=panel.querySelector('.draftDocumentStatus');
 function paint(){list.innerHTML=files.map((file,i)=>'<div class="attachmentFile"><span><strong>'+esc(file.name)+'</strong><small>'+Math.ceil(file.size/1024)+' KB</small></span><button type="button" class="btn secondary small" data-remove-draft-document="'+i+'">Remove</button></div>').join('');for(let button of list.querySelectorAll('[data-remove-draft-document]'))button.onclick=()=>{files.splice(Number(button.dataset.removeDraftDocument),1);paint()};status.textContent=files.length+' file(s) ready to save with this record.'}
 input.onchange=async()=>{busy=true;input.disabled=true;try{let selected=Array.from(input.files||[]);if(files.length+selected.length>6)throw Error('Maximum 6 files per record.');let added=[];for(let file of selected)added.push(await readAttachment(file));files=draftDocumentFiles([...files,...added]);paint()}catch(error){status.textContent=error.message;toast(error.message)}finally{busy=false;input.disabled=false;input.value=''}};
 let submitBefore=form.onsubmit;form.onsubmit=function(event){if(busy){event.preventDefault();return toast('Wait for the selected files to finish loading.')}if(!files.length)return submitBefore?.call(this,event);if(new Blob([JSON.stringify(db),JSON.stringify(files)]).size>4*1024*1024){event.preventDefault();return toast('Local storage limit reached. Use smaller files.')}let recordId=form.querySelector('[name="id"]')?.value||form.querySelector('[name="godown_id"]')?.value||jobDraft?.record.id;if(!recordId){event.preventDefault();return toast('Record ID is missing. Reopen this form before attaching files.')}activeDocumentSave={key,id:recordId,files:structuredClone(files),before:structuredClone(db)};try{return submitBefore?.call(this,event)}finally{activeDocumentSave=null}};
}
const editBeforeDocumentCoverage=editRecord;
editRecord=function(key,id,initial){editBeforeDocumentCoverage(key,id,initial);if(!['jobs','sales','purchases'].includes(key))ensureRecordDocuments(key,id,$('#recordForm'))};
const billBeforeDocumentCoverage=billForm;
billForm=function(key,id,initial){billBeforeDocumentCoverage(key,id,initial);ensureRecordDocuments(key,id,$('#billForm'))};
const godownFormBeforeDocuments=openGodownOpeningForm;
openGodownOpeningForm=function(partId){godownFormBeforeDocuments(partId);ensureRecordDocuments('parts',partId,$('#godownOpeningForm'))};
const godownActionsBeforeDocuments=openGodownActions;
openGodownActions=function(id){godownActionsBeforeDocuments(id);let footer=$('#modalBody .formactions');if(footer&&find('parts',id))footer.insertAdjacentHTML('afterbegin','<button type="button" class="btn secondary" data-manage-attachments="parts|'+esc(id)+'">'+icon('paperclip')+' Documents & Images ('+attachmentFiles(find('parts',id)).length+')</button>')};
const renderBeforeDocumentCoverage=render;
render=function(){renderBeforeDocumentCoverage();if(!attachmentModules.includes(page))return;for(let button of $$('#content [data-edit]')){let [key,id]=button.dataset.edit.split('|');if(!attachmentModules.includes(key)||button.parentNode.querySelector('[data-manage-attachments]'))continue;button.insertAdjacentHTML('beforebegin','<button type="button" class="btn small extraAction blue" data-manage-attachments="'+key+'|'+esc(id)+'" title="Documents & Images" aria-label="Documents & Images">'+icon('paperclip')+' '+attachmentFiles(find(key,id)).length+'</button>')}};
render();
