 messageBeforeUnifiedFileShare(phone,message);
 if(!context||!find(context.key,context.id))return;
 let record=find(context.key,context.id),isPolicy=context.key==='insurance';
 let preview=$('#receiptImagePreview'),textBox=$('#whatsappMessage');
 if(isPolicy&&!textBox)return;
 if(!isPolicy&&!preview)return;
 let panel=document.createElement('section');panel.className='invoiceMediaPanel';
 panel.innerHTML=`<h3>${isPolicy?'Share Policy & All Files':'Share Invoice & All Files'}</h3><p>Customer mobile: <strong>${esc(phone||'Not supplied')}</strong></p><a id="openCustomerWhatsapp" class="btn success" target="_blank" rel="noopener noreferrer" aria-disabled="true" tabindex="-1">Open WhatsApp Chat with Customer</a><p>Choose photos, videos or PDFs on this device for temporary sharing. Files selected in Documents & Images for this record are included for this tab only; files are never saved to the record or website.</p>${!isPolicy?'<button type="button" class="btn secondary" id="prepareInvoicePdf">Preview / Print Invoice</button><button type="button" class="btn secondary" id="downloadInvoicePdf" disabled>Download Invoice PDF</button><div id="invoicePdfPreview" class="invoicePdfPreview" aria-live="polite" style="max-height:380px;overflow:auto;margin:12px 0;padding:10px;background:#eef2f7;border:1px solid #dbe2ea"><p>Preparing invoice preview…</p></div>':''}<input type="file" id="invoiceMediaFiles" multiple accept="application/pdf,image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" aria-label="Select PDF, images or videos"><div id="invoiceMediaList"></div>${!isPolicy?'<label><input type="checkbox" id="includeInvoiceImage"> Also include invoice image (optional)</label>':''}<p>Up to 10 files, 50 MB per file and 100 MB total. WhatsApp and your device may apply additional limits.</p><button type="button" class="btn success" id="shareInvoiceMedia" disabled>Share ${isPolicy?'Policy':'Invoice'} & All Files</button><button type="button" class="btn secondary" id="clearInvoiceMedia">Clear Additional Files</button><p id="invoiceMediaStatus" role="status">Preparing files…</p><p>Open WhatsApp Chat with Customer takes you directly to the saved mobile number. File sharing uses the device share menu and may ask you to choose the recipient again; confirm the number before tapping Send.</p>`;
 if(isPolicy)textBox.after(panel);else preview.before(panel);
 let customerChatLink=$('#openCustomerWhatsapp'),customerWhatsAppNumber=whatsappNumber(phone);function syncCustomerChat(){if(!customerChatLink)return;if(customerWhatsAppNumber){customerChatLink.href='https://wa.me/'+customerWhatsAppNumber+'?text='+encodeURIComponent(textBox.value);customerChatLink.removeAttribute('aria-disabled');customerChatLink.removeAttribute('tabindex')}else{customerChatLink.removeAttribute('href');customerChatLink.setAttribute('aria-disabled','true');customerChatLink.setAttribute('tabindex','-1')}}syncCustomerChat();textBox.addEventListener('input',syncCustomerChat);
 let files=[],generatedInvoice=null,generatedInvoicePdf=null,shareButton=$('#shareInvoiceMedia'),status=$('#invoiceMediaStatus'),automaticFiles=[...temporaryShareFilesFor({...record,_module:context.key}),...(isPolicy?[policySummaryShareFile(record)].filter(Boolean):[])];
 function bundle(){return [...automaticFiles,...(!isPolicy&&generatedInvoicePdf?[generatedInvoicePdf]:[]),...(!isPolicy&&$('#includeInvoiceImage')?.checked&&generatedInvoice?[generatedInvoice]:[]),...files]}
 function update(){let chosen=bundle(),supported=false,bytes=chosen.reduce((n,f)=>n+f.size,0);try{supported=!!(chosen.length&&chosen.length<=10&&bytes<=100*1024*1024&&(isPolicy||!!generatedInvoicePdf)&&typeof navigator.share==='function'&&typeof navigator.canShare==='function'&&navigator.canShare({files:chosen}))}catch{}shareButton.disabled=!supported;let downloadPdfButton=$('#downloadInvoicePdf');if(downloadPdfButton)downloadPdfButton.disabled=!generatedInvoicePdf;let names=chosen.map(f=>f.name);$('#invoiceMediaList').textContent=names.length?names.join(' · '):'No files selected';status.textContent=supported?'Ready to share '+chosen.length+' file(s), including temporary files selected from this device. Choose Share, WhatsApp and the recipient.':'Direct sharing of this file bundle is unavailable here. Open WhatsApp and attach the listed device files manually.'}
 $('#invoiceMediaFiles').onchange=e=>{try{let selected=Array.from(e.target.files);validateInvoiceMedia(selected);files=selected;if(bundle().length>10||bundle().reduce((n,f)=>n+f.size,0)>100*1024*1024)throw Error('Choose files so the complete share stays within 10 files and 100 MB');update()}catch(err){files=[];e.target.value='';update();status.textContent=err.message}};
 if(!isPolicy&&$('#prepareInvoicePdf'))$('#prepareInvoicePdf').onclick=()=>{let edited=$('#whatsappMessage').value;invoice(context.key,context.id);let footer=$('#modalBody .formactions');if(footer){let back=document.createElement('button');back.type='button';back.className='btn success';back.textContent='Back to WhatsApp';back.onclick=()=>messagePreview(phone,edited,context);footer.prepend(back)}};
 if($('#includeInvoiceImage'))$('#includeInvoiceImage').onchange=update;let downloadPdfButton=$('#downloadInvoicePdf');if(downloadPdfButton)downloadPdfButton.onclick=()=>{if(!generatedInvoicePdf)return;let url=URL.createObjectURL(generatedInvoicePdf),link=document.createElement('a');link.href=url;link.download=generatedInvoicePdf.name;link.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
