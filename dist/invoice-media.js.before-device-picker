 if(!isPolicy)(()=>{let canvas=receiptCanvas(context.key,context.id);return Promise.all([canvasPng(canvas),invoiceCanvasPdf(canvas,context.id)])})().then(([blob,pdf])=>{generatedInvoice=new File([blob],'Invoice-'+context.id.replace(/[^a-z0-9_-]/gi,'-')+'.png',{type:'image/png'});generatedInvoicePdf=pdf;if(panel.isConnected){let host=$('#invoicePdfPreview');if(host){let reader=new FileReader();reader.onload=()=>{if(!panel.isConnected)return;let img=document.createElement('img');img.src=reader.result;img.alt='Preview of the invoice PDF';img.style.cssText='display:block;width:100%;height:auto;border:1px solid #dbe2ea;background:#fff';host.replaceChildren(img)};reader.readAsDataURL(generatedInvoice)}update()}}).catch(err=>{if(panel.isConnected){status.textContent='Unable to prepare the invoice PDF: '+err.message;shareButton.disabled=true}});
 update();
 shareButton.onclick=async()=>{let chosen=bundle();if(!chosen.length)return;shareButton.disabled=true;try{await navigator.share({files:chosen,title:(isPolicy?'Insurance Policy ':'Invoice ')+context.id,text:$('#whatsappMessage').value});if(panel.isConnected)status.textContent='Files handed to the device share menu. Choose WhatsApp, the recipient, and Send. Delivery is not confirmed.'}catch(err){if(panel.isConnected)status.textContent=err.name==='AbortError'?'Sharing cancelled. Your temporary files remain available in this tab.':'Sharing could not complete here. Open WhatsApp and attach the files manually.'}finally{if(panel.isConnected)shareButton.disabled=false}};
};
