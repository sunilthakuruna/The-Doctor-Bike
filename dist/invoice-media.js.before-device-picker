/* Share invoice/policy messages and a multi-file bundle through the device share sheet. */
function validateInvoiceMedia(files){if(files.length>10)throw Error('Choose up to 10 files at a time');let total=0;for(let file of files){if(!['application/pdf','image/jpeg','image/png','image/webp','video/mp4','video/webm','video/quicktime'].includes(file.type))throw Error(file.name+': choose PDF, JPG, PNG, WebP, MP4, WebM or MOV');if(file.size>50*1024*1024)throw Error(file.name+': maximum 50 MB per file');total+=file.size}if(total>100*1024*1024)throw Error('Choose files totalling no more than 100 MB');return true}
function invoiceShareMessage(b){return `${db.settings.name}\nInvoice: ${b.sourceId||b.id}\nDate: ${typeof displayDate==='function'?displayDate(b.date):b.date}\nTotal: ${money(billTotals(b).total)}\nPaid: ${money(paid(b))}\nBalance: ${money(due(b))}\nPlease see the invoice and attached documents and media.`}
function fileFromSavedAttachment(file){if(!safeAttachment(file))return null;let [head,payload]=file.data.split(','),type=(head.match(/^data:([^;]+);base64$/)||[])[1];if(!type)return null;let bytes=Uint8Array.from(atob(payload),c=>c.charCodeAt(0));return new File([bytes],file.name,{type})}
function savedShareFiles(record){return []}
function policySummaryShareFile(record){if(!record||typeof policyMessage!=='function')return null;let name='Policy-Details-'+String(record.id||'Policy').replace(/[^a-z0-9_-]/gi,'-')+'.txt';return new File([policyMessage(record)],name,{type:'text/plain'})}
async function shareSavedRecordBundleNow(key,id,phone,message){let record=find(key,id);if(!record)return false;let files=[...temporaryShareFilesFor({...record,_module:key})];if(key==='insurance'){let summary=policySummaryShareFile(record);if(summary)files.push(summary)}if(['jobs','sales'].includes(key)){try{let canvas=receiptCanvas(key,id),data=canvas.toDataURL('image/png'),payload=data.split(',')[1],bytes=Uint8Array.from(atob(payload),c=>c.charCodeAt(0));files.unshift(new File([bytes],'Invoice-'+id.replace(/[^a-z0-9_-]/gi,'-')+'.png',{type:'image/png'}));files.unshift(await invoiceCanvasPdf(canvas,id))}catch{/* Keep saved PDFs/images available if invoice-image generation fails. */}}let canShare=false;try{canShare=!!(files.length&&typeof navigator.share==='function'&&typeof navigator.canShare==='function'&&navigator.canShare({files}))}catch{}if(!canShare){messagePreview(phone,message,{key,id});return false}try{navigator.share({files,title:(key==='insurance'?'Insurance Policy ':'Invoice ')+id,text:message}).then(()=>toast('Files handed to your device share menu. Choose WhatsApp and Send.')).catch(err=>{if(err.name!=='AbortError')toast('The device could not share these files. Open the WhatsApp file-share option to try again.')});return true}catch{messagePreview(phone,message,{key,id});return false}}
async function invoiceCanvasPdf(canvas,id){let blob=await new Promise((resolve,reject)=>canvas.toBlob(value=>value?resolve(value):reject(Error('Unable to create invoice PDF')),'image/jpeg',.94)),jpg=new Uint8Array(await blob.arrayBuffer()),w=595.28,h=w*canvas.height/canvas.width,enc=new TextEncoder(),chunks=[],length=0,offsets=[0];function push(value){let bytes=typeof value==='string'?enc.encode(value):value;chunks.push(bytes);length+=bytes.length}push('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');function obj(n,body){offsets[n]=length;push(n+' 0 obj\n'+body+'\nendobj\n')}obj(1,'<< /Type /Catalog /Pages 2 0 R >>');obj(2,'<< /Type /Pages /Kids [3 0 R] /Count 1 >>');obj(3,'<< /Type /Page /Parent 2 0 R /MediaBox [0 0 '+w.toFixed(2)+' '+h.toFixed(2)+'] /Resources << /XObject << /Invoice 5 0 R >> >> /Contents 4 0 R >>');let stream='q\n'+w.toFixed(2)+' 0 0 '+h.toFixed(2)+' 0 0 cm\n/Invoice Do\nQ\n',streamBytes=enc.encode(stream);obj(4,'<< /Length '+streamBytes.length+' >>\nstream\n'+stream+'endstream');offsets[5]=length;push('5 0 obj\n<< /Type /XObject /Subtype /Image /Width '+canvas.width+' /Height '+canvas.height+' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length '+jpg.length+' >>\nstream\n');push(jpg);push('\nendstream\nendobj\n');let xref=length;push('xref\n0 6\n0000000000 65535 f \n');for(let n=1;n<=5;n++)push(String(offsets[n]).padStart(10,'0')+' 00000 n \n');push('trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n'+xref+'\n%%EOF');let pdf=new Blob(chunks,{type:'application/pdf'});return new File([pdf],'Invoice-'+String(id).replace(/[^a-z0-9_-]/gi,'-')+'.pdf',{type:'application/pdf'})}
function openInvoiceMedia(key,id){let b=find(key,id);if(!b)return;let customer=find('customers',b.customer);messagePreview(customer?.mobile||b.mobile,invoiceShareMessage(b),{key,id})}
const messageBeforeUnifiedFileShare=messagePreview;
