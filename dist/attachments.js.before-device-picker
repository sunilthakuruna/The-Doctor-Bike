/* Device-selected files stay in memory for this tab only; they are never added to records or browser storage. */
const attachmentModules=['parts','jobs','sales','purchases','insurance','expenses'];
const temporaryAttachmentFiles=new Map();
function attachmentKey(key,id){return key+'|'+id}
function attachmentFiles(record){return []}
function temporaryShareFilesFor(record){return record?temporaryAttachmentFiles.get(attachmentKey(record._module,record.id))||[]:[]}
function safeAttachment(file){return file instanceof File}
function attachmentPanel(key,id){let r=find(key,id);if(!r)return '';let files=temporaryAttachmentFiles.get(attachmentKey(key,id))||[];return `<section class="attachmentPanel" data-attachment-key="${key}" data-attachment-id="${esc(id)}"><h3>${key==='insurance'?'Insurance Policy Documents & Images':'Documents & Images'} (${files.length})</h3><p>Select files from this device when needed. They stay in this browser tab temporarily, are not saved with the record, and clear when you close or refresh the tab. PDF, images and videos · up to 10 files · 50 MB per file.</p><input type="file" data-attachment-upload multiple accept="application/pdf,image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" aria-label="Select documents images or videos temporarily"><div class="attachmentFiles">${files.map((f,i)=>`<div class="attachmentFile"><span class="attachmentPdf">${f.type.startsWith('video/')?'VIDEO':f.type.startsWith('image/')?'IMAGE':'PDF'}</span><span><strong>${esc(f.name)}</strong><small>${Math.ceil(f.size/1024)} KB · temporary</small></span><button type="button" class="btn danger small" data-attachment-remove="${i}">Remove</button></div>`).join('')||'<p>No temporary files selected. Select files above to share with the invoice or policy.</p>'}</div></section>`}
function manageAttachments(key,id){openModal('Documents & Images',`<div class="formbody">${attachmentPanel(key,id)}</div><div class="formactions">${btn('Close','cancel','secondary')}</div>`)}
function refreshAttachmentPanel(panel,key,id){let temp=document.createElement('div');temp.innerHTML=attachmentPanel(key,id);panel.replaceWith(temp.firstElementChild)}
function validateDeviceFiles(files){if(files.length>10)throw Error('Choose up to 10 files');let total=0;for(let file of files){if(!['application/pdf','image/jpeg','image/png','image/webp','video/mp4','video/webm','video/quicktime'].includes(file.type))throw Error(file.name+': choose PDF, JPG, PNG, WebP, MP4, WebM or MOV');if(file.size>50*1024*1024)throw Error(file.name+': maximum 50 MB per file');total+=file.size}if(total>100*1024*1024)throw Error('Selected files must total no more than 100 MB');return true}
/* Remove older persisted file payloads so the prototype no longer keeps uploaded attachments in its saved records. */
let removedOldAttachments=false;for(let key of attachmentModules)for(let record of (db[key]||[]))if(record.attachments?.length){delete record.attachments;removedOldAttachments=true}if(Array.isArray(db.attachments)&&db.attachments.length){db.attachments=[];removedOldAttachments=true}if(removedOldAttachments)save('Old saved attachments removed; new files are temporary');
document.addEventListener('change',e=>{if(!e.target.matches('[data-attachment-upload]'))return;let input=e.target,panel=input.closest('[data-attachment-key]'),key=panel.dataset.attachmentKey,id=panel.dataset.attachmentId;try{let files=Array.from(input.files);validateDeviceFiles(files);temporaryAttachmentFiles.set(attachmentKey(key,id),files);refreshAttachmentPanel(panel,key,id)}catch(err){toast(err.message)}finally{input.value=''}},true);
document.addEventListener('click',e=>{let manager=e.target.closest('[data-manage-attachments]');if(manager){e.preventDefault();let [key,id]=manager.dataset.manageAttachments.split('|');manageAttachments(key,id);return}let button=e.target.closest('[data-attachment-remove]');if(!button)return;e.preventDefault();let panel=button.closest('[data-attachment-key]'),key=panel.dataset.attachmentKey,id=panel.dataset.attachmentId,files=temporaryAttachmentFiles.get(attachmentKey(key,id))||[];temporaryAttachmentFiles.set(attachmentKey(key,id),files.filter((_,i)=>i!==Number(button.dataset.attachmentRemove)));refreshAttachmentPanel(panel,key,id)},true);
const renderBeforeTemporaryAttachments=render;
render=function(){renderBeforeTemporaryAttachments();if(!attachmentModules.includes(page))return;for(let button of $$('#content [data-edit]')){let [key,id]=button.dataset.edit.split('|');if(!attachmentModules.includes(key)||button.parentNode.querySelector('[data-manage-attachments]'))continue;button.insertAdjacentHTML('beforebegin',`<button type="button" class="btn small extraAction blue" data-manage-attachments="${key}|${esc(id)}" title="Temporary Documents, Images & Videos" aria-label="Select temporary files">${icon('paperclip')}</button>`)}let toolbar=$('#content .toolbar');if(toolbar&&!toolbar.querySelector('[data-attachment-picker]')){let button=document.createElement('button');button.type='button';button.className='btn secondary';button.textContent='Documents, Images & Videos';button.dataset.attachmentPicker='';button.onclick=()=>{let key=page;openModal('Select Record for Temporary Files',`<div class="formbody"><label class="field"><span>Record</span><select id="attachmentRecord">${opts(db[key].map(r=>({value:r.id,label:r.id+' — '+(r.name||r.vehicleNumber||r.number||r.supplier||r.customerName||'')})))}</select></label></div><div class="formactions"><button type="button" class="btn" id="attachmentRecordOpen">Select Temporary Files</button></div>`);$('#attachmentRecordOpen').onclick=()=>{let id=$('#attachmentRecord').value;if(id)manageAttachments(key,id);else toast('Select a saved record first')}};toolbar.appendChild(button)}};
function addFormAttachments(key,id){if(!attachmentModules.includes(key))return;let form=$('#recordForm')||$('#billForm'),body=form?.querySelector('.formbody');if(!body)return;if(id&&find(key,id))body.insertAdjacentHTML('beforeend',attachmentPanel(key,id));else body.insertAdjacentHTML('beforeend','<div class="notice">Save this record first, then select temporary files for sharing. Files are not stored with the record.</div>')}
const editBeforeTemporaryAttachments=editRecord;
editRecord=function(key,id,initial){editBeforeTemporaryAttachments(key,id,initial);if(!['jobs','sales','purchases'].includes(key))addFormAttachments(key,id)};
const billBeforeTemporaryAttachments=billForm;
billForm=function(key,id,initial){billBeforeTemporaryAttachments(key,id,initial);addFormAttachments(key,id)};
render();
