/* Capture existing thermal actions before the older generic invoice action. */
const invoiceBeforeThermal=invoice;
invoice=function(key,id){invoiceBeforeThermal(key,id);let footer=$('#modalBody .formactions');if(footer&&['jobs','sales'].includes(key)){let button=document.createElement('button');button.type='button';button.className='btn secondary';button.textContent='Thermal Receipt';button.onclick=()=>openThermalInvoice(key,id);footer.prepend(button)}};
const settingsBeforeThermal=settingsPage;
settingsPage=function(){return settingsBeforeThermal()+`<section class="panel"><div class="panelhead"><h2>Thermal Printer</h2></div><div class="panelbody"><label class="field"><span>Default Receipt Paper Width</span><select id="defaultThermalWidth"><option value="58" ${Number(db.settings.thermalWidth)===58?'selected':''}>58 mm</option><option value="80" ${Number(db.settings.thermalWidth)!==58?'selected':''}>80 mm</option></select></label><p>Supports 58 mm and 80 mm receipt layouts through your browser and installed printer driver. USB, network or Bluetooth connection is managed by your computer or phone.</p><button type="button" class="btn" id="saveThermalWidth">Save Thermal Setting</button></div></section>`};
const renderBeforeThermal=render;
render=function(){renderBeforeThermal();if(page==='settings'&&$('#saveThermalWidth'))$('#saveThermalWidth').onclick=()=>{let previous=db.settings.thermalWidth;db.settings.thermalWidth=Number($('#defaultThermalWidth').value)===58?58:80;if(save('Thermal printer setting saved')===false)db.settings.thermalWidth=previous};if(['jobs','sales'].includes(page)){for(let b of $$('#content [data-invoice]')){let [key,id]=b.dataset.invoice.split('|');let old=b.parentNode.querySelector('[data-extra-action="thermal"]');if(old){old.removeAttribute('data-extra-action');old.title='Print Thermal Receipt (58 / 80 mm)';old.setAttribute('aria-label',old.title);old.onclick=()=>openThermalInvoice(key,id)}else{let button=document.createElement('button');button.type='button';button.className='btn small extraAction blue';button.title='Print Thermal Receipt (58 / 80 mm)';button.setAttribute('aria-label',button.title);button.innerHTML=icon('print');button.onclick=()=>openThermalInvoice(key,id);b.after(button)}}}};
render();
/* Every invoice preview exposes both formats and clears the previous print size. */
function clearInvoicePrintMode(){document.body.classList.remove('printingThermal','printingA4');$('#thermalPageSize')?.remove();$('#a4PageSize')?.remove();$('#modalBody')?.classList.remove('thermalReceipt')}
const modalBeforePrintChoice=openModal;
openModal=function(title,html){clearInvoicePrintMode();return modalBeforePrintChoice(title,html)};
function printA4Invoice(){clearInvoicePrintMode();let style=document.createElement('style');style.id='a4PageSize';style.textContent='@media print{@page{size:A4 portrait;margin:10mm}}';document.head.appendChild(style);document.body.classList.add('printingA4');const cleanup=()=>{clearInvoicePrintMode();window.removeEventListener('afterprint',cleanup)};window.addEventListener('afterprint',cleanup);try{window.print()}catch{cleanup();toast('Open the browser print menu to print this invoice.')}}
function invoiceFormatControls(key,id,selected){return `<div class="invoiceFormatControls"><strong>Invoice format:</strong><button type="button" class="btn ${selected==='a4'?'':'secondary'}" id="chooseA4Invoice">A4 Invoice</button><button type="button" class="btn ${selected==='thermal'?'':'secondary'}" id="chooseThermalInvoice">Thermal Receipt (58 / 80 mm)</button></div>`}
const invoiceBeforeFormatChoice=invoice;
invoice=function(key,id){invoiceBeforeFormatChoice(key,id);if(!find(key,id))return;$('#modalTitle').textContent='A4 Invoice';let body=$('#modalBody');body.insertAdjacentHTML('afterbegin',invoiceFormatControls(key,id,'a4'));$('#chooseA4Invoice').onclick=()=>invoice(key,id);$('#chooseThermalInvoice').onclick=()=>openThermalInvoice(key,id);for(let button of $$('#modalBody [data-action="print"]')){button.removeAttribute('data-action');button.textContent='Print A4 / Save PDF';button.onclick=printA4Invoice}};
const thermalBeforeFormatChoice=openThermalInvoice;
openThermalInvoice=function(key,id,width){thermalBeforeFormatChoice(key,id,width);$('#modalBody').insertAdjacentHTML('afterbegin',invoiceFormatControls(key,id,'thermal'));$('#chooseA4Invoice').onclick=()=>invoice(key,id);$('#chooseThermalInvoice').onclick=()=>openThermalInvoice(key,id,$('#thermalPaperWidth').value)};
const renderBeforeFormatChoice=render;
render=function(){renderBeforeFormatChoice();if(!['jobs','sales'].includes(page))return;for(let button of $$('#content [data-invoice]')){button.title='View A4 Invoice';button.setAttribute('aria-label','View A4 Invoice');button.innerHTML=icon('file')+'<span>A4</span>';let thermal=button.parentNode.querySelector('[title="Print Thermal Receipt (58 / 80 mm)"]');if(thermal)thermal.innerHTML=icon('print')+'<span>Thermal</span>'}};
render();
function invoiceTypeOf(b){return b.invoiceType||(Number(billTotals(b).tax)>0?'gst':'non-gst')}
const totalsBeforeInvoiceType=billTotals;
billTotals=function(b){return b.invoiceType==='non-gst'?(b.importedTotals&&Number(b.importedTotals.tax)===0&&(!b.importedBillingSignature||b.importedBillingSignature===billingSignature(b))?{...b.importedTotals}:originalBillTotals(b)):totalsBeforeInvoiceType(b)};
const draftTotalsBeforeInvoiceType=updateBillTotals;
updateBillTotals=function(){if(jobDraft){let selected=$('#billForm [name="invoiceType"]');if(selected&&jobDraft.record.invoiceType)jobDraft.record.invoiceType=selected.value}draftTotalsBeforeInvoiceType()};
document.addEventListener('change',e=>{if(e.target.name!=='invoiceType'||!jobDraft)return;jobDraft.record.invoiceType=e.target.value;if(jobDraft.record.invoiceType==='non-gst'){jobDraft.record.tax=0;for(let line of jobDraft.record.partLines||[])line.gst=0;if($('#labourTax'))$('#labourTax').value=0;}if(jobDraft.record.importedTotals&&jobDraft.record.invoiceType==='non-gst'&&Number(jobDraft.record.importedTotals.tax)!==0)delete jobDraft.record.importedTotals;lineRender();updateBillTotals()},true);
const invoiceBeforeTaxLabel=invoice;
invoice=function(key,id){invoiceBeforeTaxLabel(key,id);let b=find(key,id);if(!b)return;let caption=$('#modalBody .taxCaption');if(caption)caption.textContent=invoiceTypeOf(b)==='gst'?'GST TAX INVOICE':'NON-GST INVOICE';if(invoiceTypeOf(b)==='non-gst'){let sheet=$('#modalBody .invoice');if(sheet){for(let p of sheet.querySelectorAll('p'))if(p.textContent.includes('GSTIN:'))p.innerHTML=p.innerHTML.replace(/GSTIN:[^<]*/g,'');for(let header of sheet.querySelectorAll('th'))if(header.textContent.includes('GST')){let index=header.cellIndex;header.textContent='Tax';for(let row of header.closest('table').tBodies[0]?.rows||[])if(row.cells[index])row.cells[index].textContent='—';}}}};
const settingsBeforeInvoiceTypes=settingsPage;
settingsPage=function(){return settingsBeforeInvoiceTypes()+`<section class="panel"><div class="panelhead"><h2>Invoice Type</h2></div><div class="panelbody"><label class="field"><span>Default for New Job Cards and Sales</span><select id="defaultInvoiceType"><option value="gst" ${db.settings.defaultInvoiceType!=='non-gst'?'selected':''}>GST Invoice</option><option value="non-gst" ${db.settings.defaultInvoiceType==='non-gst'?'selected':''}>Non-GST Invoice</option></select></label><button type="button" class="btn" id="saveInvoiceType">Save Invoice Type</button><p>Change an individual bill’s Invoice Type in its edit form. Non-GST bills calculate without GST; changing the type can change the total.</p></div></section>`};
const renderBeforeInvoiceTypes=render;
render=function(){renderBeforeInvoiceTypes();if(page==='settings'&&$('#saveInvoiceType'))$('#saveInvoiceType').onclick=()=>{let previous=db.settings.defaultInvoiceType;db.settings.defaultInvoiceType=$('#defaultInvoiceType').value;if(save('Default invoice type saved')===false)db.settings.defaultInvoiceType=previous}};
render();



