/* Autofill is selection-based; it never creates contracts or due dates from guesses. */
function savedRecordOptions(key){return (db[key]||[]).map(r=>({value:r.id,label:r.id+' — '+(r.name||r.number||r.vehicleNumber||r.supplier||r.description||'')+(r.mobile?' — '+r.mobile:'')}))}
function addSavedRecordLoader(key){let form=$('#recordForm');if(!form||form.querySelector('.savedRecordLoader')||!db[key]?.length)return;let panel=document.createElement('div');panel.className='savedRecordLoader';panel.innerHTML=`<label class="field"><span>Use Previously Saved ${esc(titles[key]||'Record')}</span><select data-load-saved-record aria-label="Find saved record"><option value="">Select saved record…</option>${opts(savedRecordOptions(key))}</select></label><button type="button" class="btn secondary small" data-load-saved-button>Load Saved Record</button><small>Loads that record for editing. Unsaved entries in this form will be replaced.</small>`;form.querySelector('.formbody').before(panel);let select=panel.querySelector('select');panel.querySelector('button').onclick=()=>{if(!select.value)return toast('Select an existing record first.');editRecord(key,select.value)};if(select.options.length>8)makeSearchSelect(select)}
function savedBillingDetails(record){let c=find('customers',record.customer),b=find('bikes',record.bike);return {customer:c?.name||'',mobile:c?.mobile||'',email:c?.email||'',address:c?.address||'',gst:c?.gst||'',vehicle:b?.number||'',make:b?.brand||'',model:b?.model||'',variant:b?.variant||'',mechanic:name('staff',record.mechanic)||''}}
function savedBillingDetailsMarkup(record){let d=savedBillingDetails(record);return `<strong>Previously Saved Details</strong><dl>${[['Customer',d.customer],['Mobile',d.mobile],['Email',d.email],['Address',d.address],['Customer GSTIN',d.gst],['Vehicle',d.vehicle],['Make / Model',[d.make,d.model,d.variant].filter(Boolean).join(' ')],['Assigned Mechanic',d.mechanic]].filter(([,v])=>v).map(([label,value])=>`<div><dt>${label}</dt><dd>${esc(value)}</dd></div>`).join('')||'<p>Select a saved customer or vehicle to see its details.</p>'}</dl>`}
function bindSavedBillingDetails(){let form=$('#billForm');if(!form||!jobDraft)return;let panel=document.createElement('section');panel.className='savedBillingDetails';let grid=form.querySelector('.jobLeft .formgrid')||form.querySelector('.formgrid');if(!grid)return;grid.after(panel);function sync(){if(!jobDraft)return;let customer=form.querySelector('[name="customer"]'),bike=form.querySelector('[name="bike"]'),mechanic=form.querySelector('[name="mechanic"]');let view={...jobDraft.record,customer:customer?.value||'',bike:bike?.value||'',mechanic:mechanic?.value||''};panel.innerHTML=savedBillingDetailsMarkup(view);let c=find('customers',view.customer),b=find('bikes',view.bike);if(customer){jobDraft.record.customerName=c?.name||'';if(!b&&bike)jobDraft.record.vehicleNumber=''}if(b)jobDraft.record.vehicleNumber=b.number;jobDraft.record.mechanicName=name('staff',view.mechanic)||''}for(let name of ['customer','bike','mechanic'])form.querySelector('[name="'+name+'"]')?.addEventListener('change',sync);sync();if(jobDraft.key==='purchases'){let supplier=form.querySelector('[name="supplier"]');if(supplier){let list=document.createElement('datalist');list.id='savedSupplierNames';list.innerHTML=[...new Set(db.purchases.map(p=>p.supplier).filter(Boolean))].map(v=>`<option value="${esc(v)}"></option>`).join('');supplier.setAttribute('list',list.id);form.appendChild(list);panel.innerHTML='<strong>Saved Supplier Names</strong><p>Choose a previous supplier from the supplier field suggestions. Enter the new purchase invoice number separately.</p>'}}}
function setSavedFormValue(form,key,value){let input=form.querySelector('[name="'+key+'"]');if(!input)return;input.value=value||'';let code=input.closest('.phoneInput')?.querySelector('[data-phonecode]');let match=String(value||'').match(/^\+(\d{1,3})\s/);if(code&&match&&Array.from(code.options).some(o=>o.value===match[1]))code.value=match[1]}
function fillAppointmentFromVehicle(form,id){let b=find('bikes',id);if(!b)return;let c=find('customers',b.customer);for(let [key,value]of [['name',c?.name],['mobile',c?.mobile],['number',b.number],['brand',b.brand],['model',b.model]])setSavedFormValue(form,key,value)}
function addAppointmentAutofill(){let form=$('#recordForm');if(!form)return;let panel=document.createElement('section');panel.className='appointmentAutofill';panel.innerHTML=`<strong>Fill from Saved Customer / Vehicle</strong><label class="field"><span>Customer</span><select data-appointment-customer><option value="">Select customer…</option>${opts(reference('customers'))}</select></label><label class="field"><span>Vehicle</span><select data-appointment-vehicle><option value="">Select vehicle…</option>${opts(db.bikes.map(b=>({value:b.id,label:b.number+' — '+name('customers',b.customer)})))}</select></label>`;form.querySelector('.formbody').prepend(panel);let customer=panel.querySelector('[data-appointment-customer]'),vehicle=panel.querySelector('[data-appointment-vehicle]');customer.onchange=()=>{let c=find('customers',customer.value);setSavedFormValue(form,'name',c?.name);setSavedFormValue(form,'mobile',c?.mobile);for(let name of ['number','brand','model'])setSavedFormValue(form,name,'');vehicle.innerHTML='<option value="">Select vehicle…</option>'+opts(db.bikes.filter(b=>!customer.value||b.customer===customer.value).map(b=>({value:b.id,label:b.number})));};vehicle.onchange=()=>{let b=find('bikes',vehicle.value);if(!b)return;customer.value=b.customer;fillAppointmentFromVehicle(form,b.id)}}
const editBeforeSavedFormAutofill=editRecord;
editRecord=function(key,id,initial){editBeforeSavedFormAutofill(key,id,initial);if(['customers','bikes','parts','services','staff','accounts','appointments','insurance','expenses'].includes(key))addSavedRecordLoader(key);if(key==='appointments')addAppointmentAutofill()};
const billBeforeSavedFormAutofill=billForm;
billForm=function(key,id,initial){billBeforeSavedFormAutofill(key,id,initial);bindSavedBillingDetails()};
const linesBeforeSavedPartInfo=lineRender;
lineRender=function(){linesBeforeSavedPartInfo();if(!jobDraft)return;for(let input of $$('#partLines [data-line^="part|"]')){let part=find('parts',input.value);if(!part)continue;let note=document.createElement('small');note.className='savedPartInfo';note.textContent=[part.id,part.brand,part.vehicleMake,part.vehicleModel,part.hsn?'HSN: '+part.hsn:'',part.category,part.unit||'PCS',savedPartStockLabel(part,jobDraft)].filter(Boolean).join(' · ');input.after(note);makeSearchSelect(input)}};
const editBeforeVehicleContactAutofill=editRecord;
editRecord=function(key,id,initial){editBeforeVehicleContactAutofill(key,id,initial);if(key!=='bikes')return;let form=$('#recordForm'),customer=form?.querySelector('[name="customer"]');if(!customer)return;let panel=document.createElement('section');panel.className='savedBillingDetails';customer.closest('.field').after(panel);let sync=()=>panel.innerHTML=savedBillingDetailsMarkup({customer:customer.value});customer.addEventListener('change',sync);sync()};
function savedPartMatches(query,limit=12){
  let words=String(query||'').trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
  return (db.parts||[]).filter(part=>{let text=[part.name,part.id,part.brand,part.vehicleMake,part.vehicleModel].filter(Boolean).join(' ').toLocaleLowerCase();return words.every(word=>text.includes(word))}).sort((a,b)=>{
    let exact=part=>String(part.name||'').toLocaleLowerCase()===String(query||'').trim().toLocaleLowerCase()?0:1;
    return exact(a)-exact(b)||String(a.name||'').localeCompare(String(b.name||''))||String(a.id).localeCompare(String(b.id));
  }).slice(0,limit);
}
function addPartNameAutofill(){
  let form=$('#recordForm'),input=form?.querySelector('[name="name"]');if(!input||form.querySelector('.partNameMatches'))return;
  let box=document.createElement('div');box.className='partNameMatches';box.id='savedPartNameMatches';box.hidden=true;box.setAttribute('role','listbox');box.setAttribute('aria-label','Saved spare parts');input.after(box);
  let hint=document.createElement('small');hint.className='partNameAutofillHint';hint.textContent='Type a part name to find saved parts. Select a match to load and edit its saved details, or enter a new name to create a part.';box.after(hint);
  input.setAttribute('autocomplete','off');input.setAttribute('role','combobox');input.setAttribute('aria-autocomplete','list');input.setAttribute('aria-controls',box.id);input.setAttribute('aria-expanded','false');
  let matches=[],active=-1;
  function close(){box.hidden=true;input.setAttribute('aria-expanded','false');input.removeAttribute('aria-activedescendant');active=-1}
  function choose(index){let part=matches[index];if(!part)return;close();editRecord('parts',part.id)}
  function highlight(index){active=index;let buttons=Array.from(box.querySelectorAll('[data-part-match]'));buttons.forEach((button,i)=>button.setAttribute('aria-selected',String(i===active)));if(buttons[active]){input.setAttribute('aria-activedescendant',buttons[active].id);buttons[active].scrollIntoView({block:'nearest'})}}
  function show(){matches=savedPartMatches(input.value);active=-1;input.removeAttribute('aria-activedescendant');box.innerHTML=matches.length?matches.map((part,index)=>`<button type="button" role="option" aria-selected="false" id="savedPartNameMatch${index}" data-part-match="${index}"><strong>${esc(part.name||part.id)}</strong><small>${esc([part.id,part.brand,part.vehicleMake,part.vehicleModel].filter(Boolean).join(' · '))}</small></button>`).join(''):'<small class="partNameNoMatch">No saved part matches. You can enter a new part.</small>';box.hidden=false;input.setAttribute('aria-expanded','true');box.querySelectorAll('[data-part-match]').forEach(button=>{button.onpointerdown=event=>event.preventDefault();button.onclick=event=>{event.preventDefault();choose(Number(button.dataset.partMatch))}})}
  input.addEventListener('input',show);input.addEventListener('focus',show);input.addEventListener('blur',()=>setTimeout(()=>{if(!box.contains(document.activeElement))close()},150));
  input.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();close()}else if(event.key==='ArrowDown'||event.key==='ArrowUp'){event.preventDefault();if(box.hidden)show();if(matches.length)highlight(active<0?(event.key==='ArrowDown'?0:matches.length-1):(active+(event.key==='ArrowDown'?1:-1)+matches.length)%matches.length)}else if(event.key==='Enter'&&!box.hidden&&active>=0){event.preventDefault();choose(active)}});
}
const editBeforePartNameAutofill=editRecord;
editRecord=function(key,id,initial){editBeforePartNameAutofill(key,id,initial);if(key==='parts')addPartNameAutofill()};

function savedPartStockLabel(part,draft){let godown=draft.key==='purchases'&&draft.record.stockLocation==='godown'&&typeof locationStock==='function';let qty=godown?locationStock(part.id,'godown',draft.id):stock(part.id,draft.id);return (godown?'Godown stock: ':'Main stock: ')+qty+' '+(part.unit||'PCS')}
